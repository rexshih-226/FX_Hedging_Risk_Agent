{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risk-agent.local/schemas/phase1_output.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PREPARED",
        "NEEDS_DATA",
        "HUMAN_REVIEW"
      ]
    },
    "constraint_bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "approval_scope": {
      "const": "DEMO_POLICY_ONLY"
    },
    "execution_allowed": {
      "const": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "exposure_id": {
          "type": "string",
          "minLength": 1
        },
        "max_hedge_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hedge_ratio_basis": {
          "const": "GROSS_NOTIONAL"
        },
        "include_existing_hedges": {
          "const": true
        },
        "existing_notional": {
          "type": "number",
          "minimum": 0
        },
        "max_new_notional": {
          "type": "number",
          "minimum": 0
        },
        "notional_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "allowed_products": {
          "const": [
            "deliverable_forward"
          ]
        },
        "required_direction": {
          "enum": [
            "BUY_BASE",
            "SELL_BASE"
          ]
        },
        "required_maturity_date": {
          "type": "string",
          "format": "date"
        },
        "max_stress_loss_usd": {
          "type": "number",
          "minimum": 0
        },
        "spot_shocks": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": -1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "market_snapshot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "exposure_id",
        "max_hedge_ratio",
        "hedge_ratio_basis",
        "include_existing_hedges",
        "existing_notional",
        "max_new_notional",
        "notional_currency",
        "allowed_products",
        "required_direction",
        "required_maturity_date",
        "max_stress_loss_usd",
        "spot_shocks",
        "market_snapshot_id"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "https://risk-agent.local/schemas/common.json#/$defs/check"
      }
    },
    "external_reviews": {
      "type": "array",
      "items": {
        "$ref": "https://risk-agent.local/schemas/common.json#/$defs/external"
      },
      "minItems": 5
    },
    "next_action": {
      "enum": [
        "SEND_TO_STRATEGY",
        "REFRESH_CONTEXT",
        "ESCALATE"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "status",
    "constraint_bundle_id",
    "context_hash",
    "policy_version",
    "policy_hash",
    "created_at",
    "valid_until",
    "approval_scope",
    "execution_allowed",
    "constraints",
    "checks",
    "external_reviews",
    "next_action"
  ],
  "additionalProperties": false
}
