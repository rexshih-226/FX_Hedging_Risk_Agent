{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risk-agent.local/schemas/phase1_input.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "DEMO",
        "LIVE"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "entity": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "tax_residency": {
          "type": "string",
          "minLength": 1
        },
        "functional_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "accounting_basis": {
          "enum": [
            "US_GAAP",
            "IFRS",
            "OTHER"
          ]
        }
      },
      "required": [
        "entity_id",
        "name",
        "jurisdiction",
        "tax_residency",
        "functional_currency",
        "accounting_basis"
      ],
      "additionalProperties": false
    },
    "counterparty": {
      "type": "object",
      "properties": {
        "counterparty_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "counterparty_id",
        "name",
        "jurisdiction",
        "branch"
      ],
      "additionalProperties": false
    },
    "exposure": {
      "type": "object",
      "properties": {
        "exposure_id": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "exposure_amount": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "maturity_date": {
          "type": "string",
          "format": "date"
        },
        "purpose": {
          "enum": [
            "OPERATING_EXPENSE",
            "MONETARY_ASSET_LIABILITY"
          ]
        }
      },
      "required": [
        "exposure_id",
        "currency",
        "exposure_amount",
        "maturity_date",
        "purpose"
      ],
      "additionalProperties": false
    },
    "existing_hedges": {
      "type": "array",
      "items": {
        "$ref": "https://risk-agent.local/schemas/common.json#/$defs/trade"
      }
    },
    "market": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "base_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "quote_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "spot": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "snapshot_id",
        "as_of",
        "base_currency",
        "quote_currency",
        "spot"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "mode",
    "as_of",
    "entity",
    "counterparty",
    "exposure",
    "existing_hedges",
    "market"
  ],
  "additionalProperties": false
}
